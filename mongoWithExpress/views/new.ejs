<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>new chat</title>
  </head>
  <body>
    <h2>create new chat here</h2>
    <form method="post" action="/chats">
      <input name="from" type="text" placeholder="Enter the sender name here" />
      <br />
      <br />
      <br />
      <input name="to" type="text" placeholder="Enter the reciver name here" />
      <br />
      <br />
      <br />
      <textarea name="msg" id="">
        Enter your message here
      </textarea>
      <br />
      <br />
      <br />
      <button>submit</button>
    </form>
  </body>
</html>
