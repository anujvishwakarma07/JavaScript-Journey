<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>user</title>
</head>
<body>
    <style>
        .user, tr, td, th{
            border: 2px solid black;
        }
    </style>
    <h2>Here are the user of the table</h2>
    <table class="user">
        <tr>
            <th>id</th>
            <th>username</th>
            <th>email</th>
        </tr>
        <% for(user of users) { %>
            <tr>
                <td><%=user.id%></td>
                <td><%=user.username%></td>
                <td><%=user.email%></td>
                <td><form method="get" action="/user/<%=user.id%>/edit">
                <button>Edit username</button>
                </form></td>
                <td><form method="get" action="/user/new"><button>Add</button></form>
                </td>
                <td><form method="post" action="/user/<%= user.id %>?_method=DELETE">
                    <button type="submit">Delete</button>
                </form></td>

            </tr>
            
        <% } %>
        </table>


</body>
</html>